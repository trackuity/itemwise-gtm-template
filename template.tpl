___TESTS___

scenarios:
- name: Loads the Itemwise tag right away when ad_storage is granted
  code: |-
    mock('isConsentGranted', true);

    runCode(mockData);

    assertThat(ttyCalls).isEqualTo([
      ['auto', {key: 'testKey123'}],
      ['consent', {itemwiseRecommendations: true, facebookAds: true, googleAds: true, tiktokAds: true}],
    ]);
    assertThat(injectedUrls).isEqualTo(['https://the.itemwi.se/snippet.js']);
    assertApi('addConsentListener').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Loads nothing while ad_storage is denied
  code: |-
    mock('isConsentGranted', false);
    mock('addConsentListener', (consentType, listener) => {});

    runCode(mockData);

    assertThat(ttyCalls).isEqualTo([]);
    assertThat(injectedUrls).isEqualTo([]);
    assertApi('addConsentListener').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Loads the Itemwise tag once when ad_storage is granted later
  code: |-
    mock('isConsentGranted', false);
    mock('addConsentListener', (consentType, listener) => {
      listener(consentType, false);
      listener(consentType, true);
      listener(consentType, false);
      listener(consentType, true);
    });

    runCode(mockData);

    assertThat(ttyCalls).isEqualTo([
      ['auto', {key: 'testKey123'}],
      ['consent', {itemwiseRecommendations: true, facebookAds: true, googleAds: true, tiktokAds: true}],
    ]);
    assertThat(injectedUrls).isEqualTo(['https://the.itemwi.se/snippet.js']);
setup: |-
  const mockData = {key: 'testKey123'};

  const ttyCalls = [];
  const injectedUrls = [];

  mock('createArgumentsQueue', (fnKey, arrayKey) => {
    return (action, params) => {
      ttyCalls.push([action, params]);
    };
  });
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injectedUrls.push(url);
    onSuccess();
  });


